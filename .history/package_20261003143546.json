{
  "name": "frameshot",
  "version": "0.1.0",
  "description": "固定サイズの枠の中に Web ページを表示して、静止画・動画をボタン一つで撮る撮影ツール",
  "main": "src/main/main.js",
  "productName": "Frameshot",
  "author": "lain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fixtan/Frameshot.git"
  },
  "homepage": "https://github.com/fixtan/Frameshot",
  "scripts": {
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "test:capture": "electron test/capture.selftest.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:record": "electron test/record.selftest.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.fixtan.frameshot",
    "productName": "Frameshot",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_LICENSES.md"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "frameshot-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "frameshot-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "frameshot-${version}-mac-${arch}.${ext}",
      "icon": "build/icon-mac.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "lain",
      "artifactName": "frameshot-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png"
    }
  }
}
